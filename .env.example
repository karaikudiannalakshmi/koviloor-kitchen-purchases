# --- Firebase web config (Project settings > Your apps > SDK config) ---
# Set ALL of these as PLAIN (non-sensitive) vars in Vercel so Vite can inline them at build time.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# --- App gate password (shared login for the purchase team) ---
# After entering this correctly the app calls signInAnonymously() so Firestore rules (auth != null) pass.
VITE_APP_PASSWORD=changeme
